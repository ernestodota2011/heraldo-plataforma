# T-023 (RNF-07) — plantilla del .env real del despliegue. El .env real vive
# SOLO en el host de destino (permisos 600, dueno alineado al servicio) y NUNCA
# se versiona. Este archivo no tiene ningun valor real: cada linea de abajo se
# genera al desplegar (ver runbook), nunca se copia de una nota ni de un chat.

# Imagen ya construida y transferida (nunca :latest en produccion; D-11 exige
# build fuera del servidor de despliegue y transferencia de la imagen ya construida).
HERALDO_IMAGEN=heraldo:REEMPLAZAR-POR-SHA

# Rol MIGRADOR (dueno de las tablas de Postgres). Nunca es el rol de aplicacion.
HERALDO_DB_ADMIN_USER=REEMPLAZAR
HERALDO_DB_ADMIN_PASSWORD=REEMPLAZAR

# Contrasena que el paso de migracion le da al rol heraldo_app (LOGIN). Rotarla
# aqui y re-correr `migrar_y_activar_rol.py` rota la credencial de la API.
HERALDO_APP_DB_PASSWORD=REEMPLAZAR

HERALDO_REDIS_PASSWORD=REEMPLAZAR

# Clave de cifrado de secretos en reposo (T-016). La genera
# `app.tenancy.secrets.genera_clave()` — nunca se inventa a mano.
HERALDO_SECRETOS_CLAVE=REEMPLAZAR

# RF-30: origenes admitidos, uno por uno, sin comodin. Vacio hasta que exista un
# panel/portal real que lo necesite.
HERALDO_ORIGENES_PERMITIDOS=https://heraldo.aetherlogik.com
